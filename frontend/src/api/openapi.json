        "properties": {
          "sequence_number": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Sequence Number"
          },
          "selected_number": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Selected Number"
          },
          "grid_position": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Grid Position"
          },
          "elapsed_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Elapsed Ms"
          },
          "reaction_time_ms": {
            "type": "integer",
            "maximum": 300000.0,
            "minimum": 0.0,
            "title": "Reaction Time Ms"
          }
        },
        "type": "object",
        "required": [
          "sequence_number",
          "selected_number",
          "grid_position",
          "elapsed_ms",
          "reaction_time_ms"
