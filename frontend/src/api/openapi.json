    "/api/v1/attempts/{attempt_id}": {
      "get": {
        "tags": [
          "attempts"
        ],
        "summary": "Attempt State",
        "operationId": "attempt_state_api_v1_attempts__attempt_id__get",
        "parameters": [
          {
            "name": "attempt_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Attempt Id"
