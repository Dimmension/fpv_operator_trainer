            "title": "Latest Score"
          },
          "active_attempt_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Attempt Id"
          },
          "active_progress": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
