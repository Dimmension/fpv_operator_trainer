    "/api/v1/attempts/{attempt_id}/rounds/{round_number}/answer": {
      "post": {
        "tags": [
          "attempts"
        ],
        "summary": "Memory Answer",
        "operationId": "memory_answer_api_v1_attempts__attempt_id__rounds__round_number__answer_post",
